# Machine-specific configuration
configs/paths.local.toml
.claude/settings.local.json

# Environments
.venv/
.venv-*/
__pycache__/
*.py[cod]
*.egg-info/

# Tooling
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local tutorial exports. Research exports belong in configured shared storage.
analyses/**/_outputs/

# ---------------------------------------------------------------------------
# Large data NEVER enters this repo. It lives under asset_root / work_dir on
# /bucket, which is backed up. Anything a human made — annotations, labels,
# ground truth — goes there immediately, never only into a working directory.
#
# In the retired repo this rule was not enforced and two Detectron2 COCO
# training sets plus all hand-made ground truth existed in exactly one place:
# a gitignored folder on one laptop. Do not repeat that.
# ---------------------------------------------------------------------------
*.mp4
*.slp
*.pkg.slp
*.h5
*.ckpt
*.pth
*.pt
*.joblib
*.npz

# Reproducible local experiment inputs and outputs; source assets stay on bucket.
# Historical helper sources needed by tests are explicitly tracked under work/.
# Keep new implementation in src/ or labs/; do not add generated run directories.
work/
